  "cards": [
    {
      "dot": "cyan",
      "title": "Control de código",
      "items": [
        "RESTAPP actúa como superproyecto",
        "Backend y panel quedan fijados por commit como submódulos",
        "Los repositorios externos no necesitan cambios para ser enlazados"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tres modos",
      "items": [
        "Local completo: frontends → localhost/LAN → backend local",
        "Híbrido: frontend local → API pública HTTPS",
        "VPS: dominios públicos → proxy TLS → contenedores internos"
      ]
    },
    {
      "dot": "amber",
      "title": "Condiciones mínimas",
      "items": [
        "CORS por lista permitida y soporte para clientes sin Origin",
        "PostgreSQL, Ollama y Sentiment no se publican en producción",
        "Las URLs se inyectan al compilar o ejecutar cada frontend"
      ]
    }
  ]
